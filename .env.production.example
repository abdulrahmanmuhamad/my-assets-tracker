POSTGRES_DB=my_assets_tracker
POSTGRES_USER=asset_user
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
# URL-encode special characters in the password portion of DATABASE_URL.
DATABASE_URL=postgresql://asset_user:replace-with-a-long-random-database-password@db:5432/my_assets_tracker?schema=public
NEXT_PUBLIC_APP_URL=https://assets.example.com

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_me
CLERK_SECRET_KEY=sk_live_replace_me
CLERK_WEBHOOK_SECRET=whsec_replace_me
OWNER_EMAILS=owner@example.com
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/pending-approval
ALLOW_DEV_AUTH_BYPASS=false

ENABLE_PLAID_FEATURES=false
NEXT_PUBLIC_ENABLE_STOCKS_FEATURE=false
NEXT_PUBLIC_ENABLE_BANKS_FEATURE=false
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=investments,auth,transactions,liabilities
PLAID_COUNTRY_CODES=US
PLAID_REDIRECT_URI=https://assets.example.com/stocks
PLAID_STOCKS_REDIRECT_URI=https://assets.example.com/stocks
PLAID_BANKS_REDIRECT_URI=https://assets.example.com/banks

SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# 32-byte key, base64 encoded.
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key

UPLOAD_DIR=/app/storage/uploads
MAX_UPLOAD_MB=10
METAL_PRICE_PROVIDER=yahoo
METAL_PRICE_API_KEY=
PRICE_CACHE_TTL_MINUTES=360
MARKET_INDEX_CACHE_TTL_MINUTES=15

ALERTS_EVALUATION_SECRET=replace-with-a-long-random-evaluation-secret
CRON_SECRET=
RESEND_API_KEY=
ALERT_FROM_EMAIL=Asset Alerts <alerts@assets.example.com>

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
