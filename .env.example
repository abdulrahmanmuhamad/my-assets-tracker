DATABASE_URL="postgresql://asset_user:asset_password@localhost:5432/my_assets_tracker?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Clerk passwordless authentication. Enable email-link verification in the Clerk Dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SECRET=""
OWNER_EMAILS="owner@example.com"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/pending-approval"

# Local-only bypass when Clerk keys are not configured. Never enable in production.
ALLOW_DEV_AUTH_BYPASS="true"
APP_USER_EMAIL="owner@example.com"
APP_USER_NAME="Portfolio Owner"

# SimpleFIN and SnapTrade Personal are configured by each authenticated user in the app.
# No bank or brokerage usernames/passwords are received or stored by this application.
# Keep Plaid disabled unless intentionally restoring the legacy integration.
ENABLE_PLAID_FEATURES="false"
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"
PLAID_PRODUCTS="investments,auth,transactions,liabilities"
PLAID_COUNTRY_CODES="US"
PLAID_REDIRECT_URI="http://localhost:3001/stocks"
PLAID_STOCKS_REDIRECT_URI="http://localhost:3001/stocks"
PLAID_BANKS_REDIRECT_URI="http://localhost:3001/banks"

# 32-byte key for encrypting SimpleFIN and SnapTrade credentials at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""

# Private uploads.
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_MB="10"

# Live metal pricing. API keys are only read on the server.
METAL_PRICE_PROVIDER="yahoo"
METAL_PRICE_API_KEY=""
PRICE_CACHE_TTL_MINUTES="360"
MARKET_INDEX_CACHE_TTL_MINUTES="15"

# Alert evaluation and email delivery.
# Generate the evaluation secret with the same random-key command used for TOKEN_ENCRYPTION_KEY.
ALERTS_EVALUATION_SECRET=""
CRON_SECRET=""
RESEND_API_KEY=""
ALERT_FROM_EMAIL="Asset Alerts <alerts@example.com>"

# Reserved for future SMS delivery. SMS is disabled unless a provider is implemented and configured.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
